<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>race_manager</name>
  <version>0.0.0</version>
  <description>Race manager: static-obstacle placement, collision scoring and run reports for the simulator</description>
  <maintainer email="janny030224@gmail.com">jimin1203</maintainer>
  <license>MIT</license>

  <exec_depend>ros2launch</exec_depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>f110_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
